<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Security Groups -->
        <record id="group_softcombat_manager" model="res.groups">
            <field name="name">Softcombat Manager</field>
            <field name="comment">Organizador de softcombat: gestiona armas y préstamos</field>
        </record>

        <record id="group_softcombat_admin" model="res.groups">
            <field name="name">Softcombat Administrator</field>
            <field name="comment">Administrador de softcombat: gestión completa del módulo</field>
            <field name="implied_ids" eval="[(4, ref('group_softcombat_manager'))]"/>
            <!-- Hacer que los administradores de Odoo sean automáticamente administradores de softcombat -->
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <!-- Record Rules -->
        <!-- Solo los administradores pueden eliminar registros -->
        <record id="rule_softcombat_weapon_delete" model="ir.rule">
            <field name="name">Only administrators can delete weapons</field>
            <field name="model_id" ref="model_soft_weapon"/>
            <field name="domain_force">[]</field>
            <field name="groups" eval="[(4, ref('group_softcombat_admin'))]"/>
            <field name="perm_read" eval="0"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="rule_softcombat_loan_delete" model="ir.rule">
            <field name="name">Only administrators can delete loans</field>
            <field name="model_id" ref="model_soft_loan"/>
            <field name="domain_force">[]</field>
            <field name="groups" eval="[(4, ref('group_softcombat_admin'))]"/>
            <field name="perm_read" eval="0"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="1"/>
        </record>
    </data>
</odoo>
