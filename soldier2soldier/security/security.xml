<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Definición de grupos de seguridad -->
    <record id="group_weapon_manager" model="res.groups">
        <field name="name">Administradores de Armas</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_weapon_loan_manager" model="res.groups">
        <field name="name">Administradores de Préstamos de Armas</field>
        <field name="category_id" ref="base.module_category_hidden"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Regla de registro para armas -->
    <record id="weapon_user_rule" model="ir.rule">
        <field name="name">Usuarios solo ven sus propias armas</field>
        <field name="model_id" ref="model_weapon_weapon"/>
        <field name="domain_force">[('owner_id','=',user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Regla de registro para administradores -->
    <record id="weapon_manager_rule" model="ir.rule">
        <field name="name">Administradores ven todas las armas</field>
        <field name="model_id" ref="model_weapon_weapon"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('soldier2soldier.group_weapon_manager'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
