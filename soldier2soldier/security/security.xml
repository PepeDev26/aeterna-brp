<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Categoría para los grupos de seguridad -->
        <record id="module_category_soldier2soldier" model="ir.module.category">
            <field name="name">Préstamos de Armas</field>
            <field name="description">Ayuda a gestionar los préstamos de armas entre usuarios</field>
            <field name="sequence">20</field>
        </record>

        <!-- Grupos de Seguridad -->
        <record id="group_weapon_loan_user" model="res.groups">
            <field name="name">Usuario</field>
            <field name="category_id" ref="module_category_soldier2soldier"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_weapon_loan_manager" model="res.groups">
            <field name="name">Responsable</field>
            <field name="category_id" ref="module_category_soldier2soldier"/>
            <field name="implied_ids" eval="[(4, ref('group_weapon_loan_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <!-- Reglas de Registro -->
        <!-- Las reglas se pueden añadir aquí si son necesarias -->
    </data>
</odoo>
