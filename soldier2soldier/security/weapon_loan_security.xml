<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Categoría de seguridad -->
        <record id="module_category_weapon_loan" model="ir.module.category">
            <field name="name">Préstamos de Armas</field>
            <field name="description">Gestión de préstamos de armas</field>
            <field name="sequence">20</field>
        </record>

        <!-- Grupo Usuario - Asignado a todos los usuarios internos -->
        <record id="group_weapon_loan_user" model="res.groups">
            <field name="name">Usuario</field>
            <field name="category_id" ref="module_category_weapon_loan"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Grupo Responsable -->
        <record id="group_weapon_loan_manager" model="res.groups">
            <field name="name">Responsable</field>
            <field name="category_id" ref="module_category_weapon_loan"/>
            <field name="implied_ids" eval="[(4, ref('group_weapon_loan_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <!-- Asignar automáticamente todos los usuarios internos al grupo de usuario -->
        <function model="res.groups" name="write">
            <value eval="[ref('soldier2soldier.group_weapon_loan_user')]"/>
            <value eval="{'users': [(4, ref('base.group_user'))]}"/>
        </function>
    </data>

    <data noupdate="0">
        <!-- Regla: Los usuarios pueden ver todas las armas (para comenzar) -->
        <record id="weapon_rule_all_users" model="ir.rule">
            <field name="name">Armas: acceso de lectura para todos los usuarios</field>
            <field name="model_id" ref="model_weapon_weapon"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_weapon_loan_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Regla: Los usuarios solo pueden modificar armas propias -->
        <record id="weapon_rule_personal_edit" model="ir.rule">
            <field name="name">Armas: editar solo propias</field>
            <field name="model_id" ref="model_weapon_weapon"/>
            <field name="domain_force">[('owner_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_weapon_loan_user'))]"/>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Regla: Los responsables tienen acceso total -->
        <record id="weapon_rule_manager" model="ir.rule">
            <field name="name">Armas: acceso total para responsables</field>
            <field name="model_id" ref="model_weapon_weapon"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_weapon_loan_manager'))]"/>
        </record>

        <!-- Regla: Ver préstamos propios o recibidos -->
        <record id="loan_rule_personal" model="ir.rule">
            <field name="name">Préstamos: propios o recibidos</field>
            <field name="model_id" ref="model_weapon_loan"/>
            <field name="domain_force">['|', ('loaner_id', '=', user.id), ('borrower_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_weapon_loan_user'))]"/>
        </record>

        <!-- Regla: Los responsables ven todos los préstamos -->
        <record id="loan_rule_manager" model="ir.rule">
            <field name="name">Préstamos: acceso total para responsables</field>
            <field name="model_id" ref="model_weapon_loan"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_weapon_loan_manager'))]"/>
        </record>
    </data>
</odoo>
