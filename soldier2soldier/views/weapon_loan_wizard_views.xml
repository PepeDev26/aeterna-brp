<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_weapon_loan_wizard_form" model="ir.ui.view">
        <field name="name">weapon.loan.wizard.form</field>
        <field name="model">weapon.loan.wizard</field>
        <field name="arch" type="xml">
            <form string="Prestar Equipamiento">
                <sheet>
                    <group>
                        <group>
                            <field name="weapon_id" domain="[('owner_id', '=', uid), ('current_holder_id', '=', uid)]" options="{'no_create': True}"/>
                            <field name="loaner_id" readonly="1"/>
                            <field name="borrower_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="date_start" widget="datetime"/>
                            <field name="date_end" widget="datetime"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Añade detalles adicionales sobre este préstamo..."/>
                </sheet>
                <footer>
                    <button name="action_create_loan" string="Crear Préstamo" type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
