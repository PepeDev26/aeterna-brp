<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de formulario para préstamos -->
    <record id="view_weapon_loan_form" model="ir.ui.view">
        <field name="name">weapon.loan.form</field>
        <field name="model">weapon.loan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Confirmar Préstamo" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_return" string="Registrar Devolución" type="object"
                            class="btn-success" invisible="state != 'confirmed'"/>
                    <button name="action_cancel" string="Cancelar" type="object"
                            class="btn-danger" invisible="state not in ('draft', 'confirmed')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,returned"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="loaner_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="borrower_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                            <field name="weapon_id" options="{'no_create': True}" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="date_start" readonly="state != 'draft'" widget="datetime"/>
                            <field name="date_end" readonly="state != 'draft'" widget="datetime"/>
                            <field name="date_return" readonly="1" invisible="state != 'returned'" widget="datetime"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notas">
                            <field name="notes" placeholder="Añade detalles adicionales..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Vista de árbol para préstamos - Aseguramos que solo se vean préstamos propios -->
    <record id="view_weapon_loan_tree" model="ir.ui.view">
        <field name="name">weapon.loan.tree</field>
        <field name="model">weapon.loan</field>
        <field name="arch" type="xml">
            <tree decoration-info="state == 'draft'" decoration-success="state == 'returned'" decoration-muted="state == 'cancelled'" decoration-warning="state == 'confirmed'">
                <field name="name"/>
                <field name="weapon_id"/>
                <field name="loaner_id"/>
                <field name="borrower_id"/>
                <field name="date_start" widget="datetime"/>
                <field name="date_end" widget="datetime"/>
                <field name="date_return" widget="datetime"/>
                <field name="state" decoration-success="state == 'returned'" decoration-info="state == 'draft'" decoration-danger="state == 'cancelled'" decoration-warning="state == 'confirmed'"/>
            </tree>
        </field>
    </record>

    <!-- Vista de búsqueda para préstamos -->
    <record id="view_weapon_loan_search" model="ir.ui.view">
        <field name="name">weapon.loan.search</field>
        <field name="model">weapon.loan</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="weapon_id"/>
                <field name="loaner_id"/>
                <field name="borrower_id"/>
                <filter string="Mis Préstamos" name="my_loans" domain="[('loaner_id', '=', uid)]"/>
                <filter string="Equipamiento Que Me Han Prestado" name="borrowed_by_me" domain="[('borrower_id', '=', uid)]"/>
                <filter string="Préstamos Activos" name="active_loans" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Préstamos Devueltos" name="returned_loans" domain="[('state', '=', 'returned')]"/>
                <group expand="0" string="Group By">
                    <filter string="Estado" name="groupby_state" domain="[]" context="{'group_by': 'state'}"/>
                    <filter string="Prestador" name="groupby_loaner" domain="[]" context="{'group_by': 'loaner_id'}"/>
                    <filter string="Prestatario" name="groupby_borrower" domain="[]" context="{'group_by': 'borrower_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción para Préstamos - Filtramos para mostrar solo los préstamos del usuario -->
    <record id="action_weapon_loan" model="ir.actions.act_window">
        <field name="name">Préstamos Activos</field>
        <field name="res_model">weapon.loan</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">['|', ('loaner_id', '=', uid), ('borrower_id', '=', uid)]</field>
        <field name="context">{'search_default_active_loans': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Registra tu primer préstamo
            </p>
            <p>
                Gestiona el préstamo de tu equipamiento a otros usuarios.
                Solo verás los préstamos en los que estás involucrado como prestamista o prestatario.
            </p>
        </field>
    </record>

    <!-- Acción para Historial de Préstamos -->
    <record id="action_weapon_loan_history" model="ir.actions.act_window">
        <field name="name">Historial de Préstamos</field>
        <field name="res_model">weapon.loan</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">['|', ('loaner_id', '=', uid), ('borrower_id', '=', uid)]</field>
        <field name="context">{'search_default_groupby_state': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No hay préstamos registrados
            </p>
            <p>
                Aquí podrás ver el historial completo de tus préstamos
                (tanto los préstamos que has realizado como los que has recibido).
            </p>
        </field>
    </record>

    <!-- Vista Kanban para Préstamos de Armas -->
    <record id="view_weapon_loan_kanban" model="ir.ui.view">
        <field name="name">weapon.loan.kanban</field>
        <field name="model">weapon.loan</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" records_draggable="0" class="o_kanban_small_column">
                <field name="state"/>
                <field name="weapon_id"/>
                <field name="loaner_id"/>
                <field name="borrower_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="mb-1">
                                    <strong><field name="name"/></strong>
                                </div>
                                <div class="mb-1">
                                    <span class="text-muted">Arma: </span><field name="weapon_id"/>
                                </div>
                                <div class="mb-1">
                                    <span class="text-muted">Prestador: </span><field name="loaner_id"/>
                                </div>
                                <div class="mb-1">
                                    <span class="text-muted">Prestatario: </span><field name="borrower_id"/>
                                </div>
                                <div class="mb-1">
                                    <span class="text-muted">Inicio: </span><field name="date_start"/>
                                </div>
                                <div t-if="record.date_end.raw_value" class="mb-1">
                                    <span class="text-muted">Fin previsto: </span><field name="date_end"/>
                                </div>
                                <div class="mb-1">
                                    <field name="state" widget="label_selection" options="{'classes': {'draft': 'default', 'confirmed': 'success', 'returned': 'info', 'cancelled': 'danger'}}"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Añadir la vista Kanban a la acción de ventana existente -->
    <record id="action_weapon_loan" model="ir.actions.act_window">
        <field name="name">Préstamos de Armas</field>
        <field name="res_model">weapon.loan</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea tu primer préstamo de arma
            </p>
        </field>
    </record>
</odoo>
