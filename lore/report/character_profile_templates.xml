<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_character_profile">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="article page">
                    <style>
                        /* Aplicamos estilos SOLO al contenedor del informe */
                        .character-report-specific {
                            /* Aquí pueden ir estilos específicos del informe */
                            padding: 20px;
                        }

                        /* Eliminamos todos los estilos agresivos que afectan a elementos globales */
                    </style>

                    <div class="character-report-specific">
                        <!-- Contenido del informe -->
                        <h2>Ficha de Personaje</h2>
                        <h1><span t-field="doc.name"/></h1>

                        <!-- Resto del contenido con estilos simplificados -->
                        <div class="row">
                            <div class="col-6">
                                <table class="table table-sm">
                                    <tr>
                                        <td>Edad:</td>
                                        <td><span t-field="doc.age"/></td>
                                    </tr>
                                    <tr>
                                        <td>Género:</td>
                                        <td><span t-esc="dict(doc._fields['gender'].selection).get(doc.gender, doc.gender)"/></td>
                                    </tr>
                                    <tr>
                                        <td>Altura:</td>
                                        <td><span t-field="doc.height"/></td>
                                    </tr>
                                    <tr>
                                        <td>Cabello:</td>
                                        <td><span t-field="doc.hair"/></td>
                                    </tr>
                                </table>
                            </div>
                            <div class="col-6">
                                <table class="table table-sm">
                                    <tr>
                                        <td>Piel:</td>
                                        <td><span t-field="doc.skin"/></td>
                                    </tr>
                                    <tr>
                                        <td>Iris:</td>
                                        <td><span t-field="doc.iris"/></td>
                                    </tr>
                                    <tr>
                                        <td>Constitución:</td>
                                        <td><span t-field="doc.constitution"/></td>
                                    </tr>
                                    <tr>
                                        <td>Alineamiento:</td>
                                        <td><span t-esc="dict(doc._fields['alignment'].selection).get(doc.alignment, doc.alignment)"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- ... resto del contenido ... -->
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
