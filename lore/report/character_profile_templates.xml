<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_character_profile">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="article page">
                    <style>
                        @import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600&amp;family=Crimson+Text:ital,wght@0,400;0,600;1,400&amp;display=swap');

                        /* Estilo para todas las páginas - con fondo de imagen */
                        @page {
                            size: A4;
                            margin: 0mm !important;
                            padding: 0mm !important;
                            background-color: #f5f3f0 !important;
                            background-image: url('/lore/static/img/character_background_a4.png') !important;
                            background-size: cover !important;
                            background-position: center center !important;
                            background-repeat: no-repeat !important;
                            -webkit-print-color-adjust: exact !important;
                            print-color-adjust: exact !important;
                        }

                        /* Reset global */
                        *, *::before, *::after {
                            box-sizing: border-box;
                        }

                        /* Ocultar elementos estándar de Odoo */
                        header, footer, .header, .footer, .o_report_layout_standard header,
                        .o_report_layout_standard footer, .o_clean_footer, .o_clean_header {
                            display: none !important;
                            height: 0 !important;
                            max-height: 0 !important;
                            visibility: hidden !important;
                            overflow: hidden !important;
                        }

                        /* Estilos de página */
                        html, body {
                            margin: 0 !important;
                            padding: 0 !important;
                            background-color: #f5f3f0 !important;
                            background-image: url('/lore/static/img/character_background_a4.png') !important;
                            background-size: cover !important;
                            background-position: center center !important;
                            background-repeat: no-repeat !important;
                            -webkit-print-color-adjust: exact !important;
                            print-color-adjust: exact !important;
                            height: 100% !important;
                            min-height: 100vh !important;
                            width: 100% !important;
                        }

                        /* Todos los elementos de página deben tener fondo transparente */
                        .o_report_layout_standard, .container, .article, .page {
                            background-color: transparent !important;
                            padding: 0 !important;
                            margin: 0 !important;
                            min-height: 100vh !important;
                            width: 100% !important;
                            position: relative !important;
                        }

                        /* Contenedor de la ficha */
                        .character-sheet {
                            background-color: transparent !important;
                            padding: 75px 15mm 15mm 15mm; /* Aumentado padding superior de 25px a 75px */
                            font-family: 'Crimson Text', serif;
                            color: #2c1810;
                            width: 100%; /* Ancho completo */
                            max-width: none; /* Sin máximo */
                            margin: 0 auto;
                            position: relative;
                            z-index: 10;
                        }

                        /* Cabecera ultra compacta */
                        .character-title {
                            font-family: 'Cinzel', serif;
                            font-weight: 600;
                            color: #8b4513;
                            font-size: 5.5em; /* Cambiado de 4.25em a 5.5em (2.2x) */
                            margin: 0;
                            padding: 0;
                            line-height: 1;
                            display: inline-block;
                        }

                        .character-name {
                            font-family: 'Cinzel', serif;
                            font-weight: 600;
                            font-size: 7.7em; /* Cambiado de 5.95em a 7.7em (2.2x) */
                            color: #654321;
                            margin: 0 0 0.3em 0; /* Aumentado margen inferior */
                            padding: 0;
                            line-height: 1;
                        }

                        /* Tablas con bordes más definidos */
                        .character-table {
                            background: rgba(255, 255, 255, 0.75); /* Fondo translúcido */
                            border-radius: 8px;
                            padding: 17.6px; /* Cambiado de 13.6px a 17.6px (2.2x) */
                            box-shadow: 0 2px 8px rgba(0,0,0,0.15);
                            border: 1px solid #e0d8c8;
                            width: 100%;
                            border-collapse: collapse;
                            margin-bottom: 33px; /* Cambiado de 25.5px a 33px (2.2x) */
                        }

                        .character-table td {
                            padding: 22px 26.4px; /* Cambiado de 17px 20.4px a 22px 26.4px (2.2x) */
                            border-bottom: 1px solid #e0d8c8;
                            font-size: 3.08em; /* Cambiado de 2.38em a 3.08em (2.2x) */
                            vertical-align: middle;
                        }

                        .character-table td:first-child {
                            width: 40%;
                            font-weight: bold;
                            color: #654321;
                        }

                        /* Secciones con mayor contraste */
                        .character-section {
                            background: rgba(255, 255, 255, 0.75); /* Fondo translúcido */
                            border-radius: 8px;
                            padding: 33px; /* Cambiado de 25.5px a 33px (2.2x) */
                            margin: 33px 0; /* Cambiado de 25.5px a 33px (2.2x) */
                            box-shadow: 0 2px 8px rgba(0,0,0,0.15);
                            border: 1px solid #e0d8c8;
                            border-left: 5px solid #8b4513;
                        }

                        .character-section h4 {
                            font-family: 'Cinzel', serif;
                            color: #8b4513;
                            margin: 0 0 22px 0; /* Cambiado de 17px a 22px (2.2x) */
                            font-weight: 600;
                            font-size: 3.96em; /* Cambiado de 3.06em a 3.96em (2.2x) */
                        }

                        .character-section p {
                            font-size: 2.86em; /* Cambiado de 2.21em a 2.86em (2.2x) */
                            line-height: 1.6; /* Aumentado line-height */
                            margin: 0;
                        }

                        /* Imagen adaptada al círculo */
                        .character-image {
                            width: 180px !important;         /* Tamaño fijo en lugar de máximo */
                            height: 180px !important;        /* Asegurar una forma circular perfecta */
                            border-radius: 50%;              /* Forma circular */
                            border: 4px solid #8b4513;
                            box-shadow: 0 3px 8px rgba(0,0,0,0.3);
                            background: white;
                            padding: 3px;
                            object-fit: cover !important;    /* Recortar la imagen para adaptarse */
                            object-position: center !important; /* Centrar la imagen */
                        }

                        /* Header row sin margen superior */
                        .header-row {
                            width: 100%;
                            overflow: hidden;
                            margin: 0;
                            padding: 0;
                        }

                        /* Grid simple */
                        .header-left {
                            float: left;
                            width: 66%;
                        }

                        .header-right {
                            float: right;
                            width: 33%;
                            text-align: center;
                        }

                        .table-row {
                            width: 100%;
                            overflow: hidden;
                            margin-top: 22px; /* Cambiado de 17px a 22px (2.2x) */
                        }

                        .table-col {
                            float: left;
                            width: 48%;
                        }

                        .table-col-right {
                            float: right;
                            width: 48%;
                        }

                        /* Estilos para impresión */
                        @media print {
                            @page {
                                margin: 0mm !important;
                                padding: 0mm !important;
                                background-color: #f5f3f0 !important;
                                background-image: url('/lore/static/img/character_background_a4.png') !important;
                                background-size: cover !important;
                                background-position: center center !important;
                                background-repeat: no-repeat !important;
                                -webkit-print-color-adjust: exact !important;
                                print-color-adjust: exact !important;
                            }

                            body, html, .o_report_layout_standard, .container, .article, .page {
                                background-color: transparent !important;
                                background-image: url('/lore/static/img/character_background_a4.png') !important;
                                background-size: cover !important;
                                background-position: center center !important;
                                background-repeat: no-repeat !important;
                                -webkit-print-color-adjust: exact !important;
                                print-color-adjust: exact !important;
                                margin: 0 !important;
                                padding: 0 !important;
                                height: 100% !important;
                                min-height: 100vh !important;
                                width: 100% !important;
                            }

                            .character-sheet {
                                background-color: transparent !important;
                                padding: 75px 15mm 15mm 15mm !important; /* Aumentado padding superior a 75px */
                                width: 100% !important; /* Ancho completo */
                                max-width: none !important; /* Sin máximo */
                                margin: 0 !important;
                                page-break-inside: auto !important;
                                position: relative !important;
                                z-index: 10 !important;
                            }

                            /* Mejorar legibilidad sobre el fondo */
                            .character-section, .character-table {
                                background-color: rgba(255, 255, 255, 0.75) !important; /* Translúcido en impresión */
                            }
                        }
                    </style>

                    <!-- Añadir una capa para el fondo como respaldo con tamaño 100% -->
                    <div style="position: fixed; top: 0; left: 0; width: 100%; height: 100%;
                                background-image: url('/lore/static/img/character_background_a4.png');
                                background-size: cover; background-position: center center;
                                z-index: 0; -webkit-print-color-adjust: exact !important;
                                print-color-adjust: exact !important;"></div>

                    <div class="character-sheet">
                        <div class="header-row">
                            <div class="header-left">
                                <h2 class="character-title">Ficha de Personaje</h2>
                                <h1 class="character-name"><span t-field="doc.name"/></h1>
                            </div>
                            <div class="header-right">
                                <t t-if="doc.image">
                                    <img t-att-src="image_data_uri(doc.image)"
                                         style="width: 180px; height: 180px; object-fit: cover; object-position: center;"
                                         class="character-image"
                                         alt="Character Image"/>
                                </t>
                            </div>
                        </div>

                        <div class="table-row">
                            <div class="table-col">
                                <table class="character-table">
                                    <tr>
                                        <td>Edad:</td>
                                        <td><span t-field="doc.age"/></td>
                                    </tr>
                                    <tr>
                                        <td>Género:</td>
                                        <td><span t-esc="dict(doc._fields['gender'].selection).get(doc.gender, doc.gender)"/></td>
                                    </tr>
                                    <tr>
                                        <td>Altura:</td>
                                        <td><span t-field="doc.height"/></td>
                                    </tr>
                                    <tr>
                                        <td>Cabello:</td>
                                        <td><span t-field="doc.hair"/></td>
                                    </tr>
                                </table>
                            </div>
                            <div class="table-col-right">
                                <table class="character-table">
                                    <tr>
                                        <td>Piel:</td>
                                        <td><span t-field="doc.skin"/></td>
                                    </tr>
                                    <tr>
                                        <td>Iris:</td>
                                        <td><span t-field="doc.iris"/></td>
                                    </tr>
                                    <tr>
                                        <td>Constitución:</td>
                                        <td><span t-field="doc.constitution"/></td>
                                    </tr>
                                    <tr>
                                        <td>Alineamiento:</td>
                                        <td><span t-esc="dict(doc._fields['alignment'].selection).get(doc.alignment, doc.alignment)"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <div class="character-section">
                            <h4>Rol en la Orden</h4>
                            <p t-field="doc.order_role"/>
                        </div>

                        <div class="character-section">
                            <h4>Curiosidades</h4>
                            <p t-field="doc.curiosities"/>
                        </div>

                        <div class="character-section">
                            <h4>Historia del Personaje</h4>
                            <p t-field="doc.character_history"/>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
