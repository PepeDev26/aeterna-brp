<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Vista Formulario -->
        <record id="view_character_form" model="ir.ui.view">
            <field name="name">character.profile.form</field>
            <field name="model">character.profile</field>
            <field name="arch" type="xml">
                <form>
                    <field name="is_owner" invisible="1"/>
                    <sheet>
                        <!-- Usando grupos en lugar de attrs -->
                        <field name="image" widget="image" class="oe_avatar" options="{'preview_image': 'image'}" readonly="not is_owner"/>
                        <div class="oe_title">
                            <h1>
                                <field name="name" placeholder="Nombre del Personaje" readonly="not is_owner"/>
                            </h1>
                            <!-- Mostrar propietario con avatar -->
                            <h3>
                                <div class="d-flex align-items-center mb-2">
                                    <span class="text-muted me-2">Propietario:</span>
                                    <field name="user_id" widget="many2one_avatar_user" readonly="1"/>
                                </div>
                            </h3>
                        </div>
                        <group>
                            <group>
                                <field name="age" readonly="not is_owner"/>
                                <field name="gender" readonly="not is_owner"/>
                                <field name="height" readonly="not is_owner"/>
                                <field name="hair" readonly="not is_owner"/>
                                <field name="skin" readonly="not is_owner"/>
                            </group>
                            <group>
                                <field name="iris" readonly="not is_owner"/>
                                <field name="constitution" readonly="not is_owner"/>
                                <field name="alignment" readonly="not is_owner"/>
                                <field name="order_role" readonly="not is_owner"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Curiosidades">
                                <field name="curiosities" placeholder="Añade curiosidades sobre tu personaje..." readonly="not is_owner"/>
                            </page>
                            <page string="Historia">
                                <field name="character_history" placeholder="Cuéntanos la historia de tu personaje..." readonly="not is_owner"/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Vista Lista (corregida para Odoo 17) -->
        <record id="view_character_list" model="ir.ui.view">
            <field name="name">character.profile.list</field>
            <field name="model">character.profile</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="age"/>
                    <field name="gender"/>
                    <field name="order_role"/>
                </tree>
            </field>
        </record>

        <!-- Vista Búsqueda -->
        <record id="view_character_search" model="ir.ui.view">
            <field name="name">character.profile.search</field>
            <field name="model">character.profile</field>
            <field name="arch" type="xml">
                <search>
                    <field name="name"/>
                    <field name="order_role"/>
                    <filter string="Mis Personajes" name="my_characters" domain="[('user_id', '=', uid)]"/>
                    <group expand="0" string="Agrupar Por">
                        <filter name="group_by_gender" string="Género" context="{'group_by': 'gender'}"/>
                        <filter name="group_by_alignment" string="Alineación" context="{'group_by': 'alignment'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Acciones -->
        <record id="action_character_profiles" model="ir.actions.act_window">
            <field name="name">Fichas de Personajes</field>
            <field name="res_model">character.profile</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crea tu primera ficha de personaje
                </p>
                <p>
                    Puedes registrar información detallada sobre tu personaje,
                    incluyendo características físicas, historia y curiosidades.
                </p>
            </field>
        </record>

        <record id="action_my_characters" model="ir.actions.act_window">
            <field name="name">Mis Personajes</field>
            <field name="res_model">character.profile</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('user_id', '=', uid)]</field>
            <field name="context">{'search_default_my_characters': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crea tu primera ficha de personaje
                </p>
            </field>
        </record>
    </data>
</odoo>
