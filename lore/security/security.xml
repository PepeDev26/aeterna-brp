<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Categoría para módulo lore -->
        <record id="module_category_lore" model="ir.module.category">
            <field name="name">Lore</field>
            <field name="description">Gestiona fichas de personajes</field>
            <field name="sequence">50</field>
        </record>

        <!-- Grupo de usuarios del módulo -->
        <record id="group_lore_user" model="res.groups">
            <field name="name">Usuario</field>
            <field name="category_id" ref="module_category_lore"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Grupo de administradores -->
        <record id="group_lore_admin" model="res.groups">
            <field name="name">Administrador</field>
            <field name="category_id" ref="module_category_lore"/>
            <field name="implied_ids" eval="[(4, ref('group_lore_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
