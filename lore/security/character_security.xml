<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Grupo para usuarios del módulo lore -->
        <record id="group_lore_user" model="res.groups">
            <field name="name">Lore / Usuario</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Grupo para administradores del módulo lore -->
        <record id="group_lore_manager" model="res.groups">
            <field name="name">Lore / Administrador</field>
            <field name="category_id" ref="base.module_category_hidden"/>
            <field name="implied_ids" eval="[(4, ref('group_lore_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_admin'))]"/>
        </record>

        <!-- Regla de seguridad para personajes: un usuario sólo puede editar sus propios personajes -->
        <record id="rule_character_profile_user" model="ir.rule">
            <field name="name">Usuario: acceso a sus propios personajes</field>
            <field name="model_id" ref="model_character_profile"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_lore_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <!-- Regla de seguridad para administradores: pueden ver y editar todos los personajes -->
        <record id="rule_character_profile_manager" model="ir.rule">
            <field name="name">Administrador: acceso a todos los personajes</field>
            <field name="model_id" ref="model_character_profile"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_lore_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>
    </data>
</odoo>
