<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_forge_send_email_wizard" model="ir.ui.view">
        <field name="name">forge.send.email.wizard.form</field>
        <field name="model">forge.send.email.wizard</field>
        <field name="arch" type="xml">
            <form string="Enviar Correo Electrónico">
                <group>
                    <field name="email_template_id" required="1" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_send_email" string="Enviar" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_send_email_wizard" model="ir.actions.act_window">
        <field name="name">Enviar Correo</field>
        <field name="res_model">forge.send.email.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_forge_weapon"/>
    </record>
</odoo>
