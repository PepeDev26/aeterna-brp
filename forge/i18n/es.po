#. module: forge
#: model:mail.template,body_html:forge.email_template_weapon_requested
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p>Estimado/a {{ object.client_id.name }},</p>\n"
"\n"
"                <p>Le confirmamos que hemos recibido su solicitud para la creación del arma <strong>{{ object.name }}</strong>.</p>\n"
"\n"
"                <h3>Detalles del pedido:</h3>\n"
"                <ul>\n"
"                    <li><strong>Arma:</strong> {{ object.name }}</li>\n"
"                    <li><strong>Tipo:</strong> {{ dict(object._fields['weapon_type'].selection).get(object.weapon_type) }}</li>\n"
"                    <li><strong>Estado actual:</strong> Pedida</li>\n"
"                    <li><strong>Responsable:</strong> {{ object.responsible_id.name }}</li>\n"
"                    <li><strong>Fecha de inicio:</strong> {{ object.start_date }}</li>\n"
"                    <li><strong>Fecha estimada de finalización:</strong> {{ object.end_date or 'Por determinar' }}</li>\n"
"                </ul>\n"
"\n"
"                <p>Le mantendremos informado/a sobre el progreso de su arma a través de este correo electrónico.</p>\n"
"\n"
"                <p>Gracias por confiar en nuestros servicios.</p>\n"
"\n"
"                <p>Saludos cordiales,<br>\n"
"                El equipo de la Forja</p>\n"
"            </div>\n"
"        "
msgstr "<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p>Estimado/a {{ object.client_id.name }},</p>\n"
