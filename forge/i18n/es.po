#. module: forge
#: model:mail.template,body_html:forge.email_template_weapon_in_progress
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p>Estimado/a {{ object.client_id.name }},</p>\n"
"\n"
"                <p>¡Buenas noticias! Hemos comenzado a trabajar en su arma <strong>{{ object.name }}</strong>.</p>\n"
"\n"
"                <h3>Estado actual:</h3>\n"
"                <ul>\n"
"                    <li><strong>Arma:</strong> {{ object.name }}</li>\n"
"                    <li><strong>Estado:</strong> Realizada - En proceso de forjado</li>\n"
"                    <li><strong>Progreso:</strong> {{ object.progress }}% completado</li>\n"
"                    <li><strong>Responsable:</strong> {{ object.responsible_id.name }}</li>\n"
"                </ul>\n"
"\n"
"                <p>Nuestro maestro herrero está trabajando con dedicación en su pieza. Le notificaremos cuando esté lista para entrega.</p>\n"
"\n"
"                <p>Saludos cordiales,<br>\n"
"                El equipo de la Forja</p>\n"
"            </div>\n"
"        "
msgstr "<div style=\"margin: 0px; padding: 0px;\">\n"
