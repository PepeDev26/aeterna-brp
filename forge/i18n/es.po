#. module: forge
#: model:mail.template,body_html:forge.email_template_weapon_ready
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p>Estimado/a {{ object.client_id.name }},</p>\n"
"\n"
"                <p>¡Excelentes noticias! Su arma <strong>{{ object.name }}</strong> ha sido completada y está lista para ser entregada.</p>\n"
"\n"
"                <h3>Su arma está lista:</h3>\n"
"                <ul>\n"
"                    <li><strong>Arma:</strong> {{ object.name }}</li>\n"
"                    <li><strong>Tipo:</strong> {{ dict(object._fields['weapon_type'].selection).get(object.weapon_type) }}</li>\n"
"                    <li><strong>Estado:</strong> Lista para entrega</li>\n"
"                    <li><strong>Progreso:</strong> {{ object.progress }}% completado</li>\n"
"                </ul>\n"
"\n"
"                <p>Por favor, póngase en contacto con nosotros para coordinar la entrega de su arma personalizada.</p>\n"
"\n"
"                <p><strong>Contacto:</strong></p>\n"
"                <ul>\n"
"                    <li>Responsable: {{ object.responsible_id.name }}</li>\n"
"                    <li>Email: {{ object.responsible_id.email or 'Contactar por teléfono' }}</li>\n"
"                </ul>\n"
"\n"
"                <p>¡Esperamos que disfrute de su nueva arma forjada!</p>\n"
"\n"
"                <p>Saludos cordiales,<br>\n"
"                El equipo de la Forja</p>\n"
"            </div>\n"
"        "
