#. module: forge
#: model:mail.template,body_html:forge.email_template_weapon_delivered
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-family: Arial, Helvetica, sans-serif; color: #454748;\">\n"
"                <p style=\"margin: 0px; padding: 0px; font-size: 14px;\">Estimado/a {{ object.client_id.name }},</p>\n"
"                <br>\n"
"                <p style=\"margin: 0px; padding: 0px; font-size: 14px;\">Confirmamos que su arma <strong style=\"color: #875A7B;\">{{ object.name }}</strong> ha sido entregada exitosamente.</p>\n"
"                <br>\n"
"                <div style=\"margin: 16px 0px 16px 0px;\">\n"
"                    <h3 style=\"font-size: 16px; color: #875A7B;\">Detalles de la entrega:</h3>\n"
"                    <ul style=\"margin: 16px 0px 16px 0px; padding-left: 20px;\">\n"
"                        <li style=\"margin: 0px 0px 8px 0px;\">\n"
"                            <strong style=\"font-weight: bolder;\">Arma:</strong> {{ object.name }}\n"
"                        </li>\n"
"                        <li style=\"margin: 0px 0px 8px 0px;\">\n"
"                            <strong style=\"font-weight: bolder;\">Tipo:</strong> {{ dict(object._fields['weapon_type'].selection).get(object.weapon_type) }}\n"
"                        </li>\n"
"                        <li style=\"margin: 0px 0px 8px 0px;\">\n"
"                            <strong style=\"font-weight: bolder;\">Fecha de entrega:</strong> {{ object.delivery_date or 'Hoy' }}\n"
"                        </li>\n"
"                        <li style=\"margin: 0px 0px 8px 0px;\">\n"
"                            <strong style=\"font-weight: bolder;\">Estado:</strong> Entregada\n"
"                        </li>\n"
"                    </ul>\n"
"                </div>\n"
"                <p style=\"margin: 0px; padding: 0px; font-size: 14px;\">Ha sido un placer trabajar en su proyecto. Esperamos que disfrute de su arma forjada artesanalmente.</p>\n"
"                <br>\n"
"                <p style=\"margin: 0px; padding: 0px; font-size: 14px;\">Si tiene alguna pregunta o necesita mantenimiento en el futuro, no dude en contactarnos.</p>\n"
"                <br>\n"
"                <p style=\"margin: 0px; padding: 0px; font-size: 14px;\"><strong style=\"font-weight: bolder;\">¡Gracias por elegirnos!</strong></p>\n"
"                <br>\n"
"                <p style=\"margin: 0px; padding: 0px; font-size: 14px;\">Saludos cordiales,<br>\n"
"                El equipo de la Forja</p>\n"
"            </div>\n"
"        "
msgstr ""

#. module: forge
#: model:mail.template,body_html:forge.email_template_weapon_requested
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p>Estimado/a {{ object.client_id.name }},</p>\n"
"\n"
"                <p>Le confirmamos que hemos recibido su solicitud para la creación del arma <strong>{{ object.name }}</strong>.</p>\n"
"\n"
"                <h3>Detalles del pedido:</h3>\n"
"                <ul>\n"
"                    <li><strong>Arma:</strong> {{ object.name }}</li>\n"
"                    <li><strong>Tipo:</strong> {{ dict(object._fields['weapon_type'].selection).get(object.weapon_type) }}</li>\n"
"                    <li><strong>Estado actual:</strong> Pedida</li>\n"
"                    <li><strong>Responsable:</strong> {{ object.responsible_id.name }}</li>\n"
"                    <li><strong>Fecha de inicio:</strong> {{ object.start_date }}</li>\n"
"                    <li><strong>Fecha estimada de finalización:</strong> {{ object.end_date or 'Por determinar' }}</li>\n"
"                </ul>\n"
"\n"
"                <p>Le mantendremos informado/a sobre el progreso de su arma a través de este correo electrónico.</p>\n"
"\n"
"                <p>Gracias por confiar en nuestros servicios.</p>\n"
"\n"
"                <p>Saludos cordiales,<br>\n"
"                El equipo de la Forja</p>\n"
"            </div>\n"
"        "
msgstr ""

#. module: forge
#: model:mail.template,body_html:forge.email_template_weapon_in_progress
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p>Estimado/a {{ object.client_id.name }},</p>\n"
"\n"
"                <p>¡Buenas noticias! Hemos comenzado a trabajar en su arma <strong>{{ object.name }}</strong>.</p>\n"
"\n"
"                <h3>Estado actual:</h3>\n"
"                <ul>\n"
"                    <li><strong>Arma:</strong> {{ object.name }}</li>\n"
"                    <li><strong>Estado:</strong> Realizada - En proceso de forjado</li>\n"
"                    <li><strong>Progreso:</strong> {{ object.progress }}% completado</li>\n"
"                    <li><strong>Responsable:</strong> {{ object.responsible_id.name }}</li>\n"
"                </ul>\n"
"\n"
"                <p>Nuestro maestro herrero está trabajando con dedicación en su pieza. Le notificaremos cuando esté lista para entrega.</p>\n"
"\n"
"                <p>Saludos cordiales,<br>\n"
"                El equipo de la Forja</p>\n"
"            </div>\n"
"        "
msgstr ""

#. module: forge
#: model:mail.template,body_html:forge.email_template_weapon_ready
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                <p>Estimado/a {{ object.client_id.name }},</p>\n"
"\n"
"                <p>¡Excelentes noticias! Su arma <strong>{{ object.name }}</strong> ha sido completada y está lista para ser entregada.</p>\n"
"\n"
"                <h3>Su arma está lista:</h3>\n"
"                <ul>\n"
"                    <li><strong>Arma:</strong> {{ object.name }}</li>\n"
"                    <li><strong>Tipo:</strong> {{ dict(object._fields['weapon_type'].selection).get(object.weapon_type) }}</li>\n"
"                    <li><strong>Estado:</strong> Lista para entrega</li>\n"
"                    <li><strong>Progreso:</strong> {{ object.progress }}% completado</li>\n"
"                </ul>\n"
"\n"
"                <p>Por favor, póngase en contacto con nosotros para coordinar la entrega de su arma personalizada.</p>\n"
"\n"
"                <p><strong>Contacto:</strong></p>\n"
"                <ul>\n"
"                    <li>Responsable: {{ object.responsible_id.name }}</li>\n"
"                    <li>Email: {{ object.responsible_id.email or 'Contactar por teléfono' }}</li>\n"
"                </ul>\n"
"\n"
"                <p>¡Esperamos que disfrute de su nueva arma forjada!</p>\n"
"\n"
"                <p>Saludos cordiales,<br>\n"
"                El equipo de la Forja</p>\n"
"            </div>\n"
"        "
msgstr ""

