<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Stage Tree View -->
        <record id="forge_stage_view_tree" model="ir.ui.view">
            <field name="name">forge.stage.tree</field>
            <field name="model">forge.stage</field>
            <field name="arch" type="xml">
                <tree string="Forge Stages">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="fold"/>
                </tree>
            </field>
        </record>

        <!-- Stage Form View -->
        <record id="forge_stage_view_form" model="ir.ui.view">
            <field name="name">forge.stage.form</field>
            <field name="model">forge.stage</field>
            <field name="arch" type="xml">
                <form string="Forge Stage">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="fold"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Stage Action Window -->
        <record id="action_forge_stage" model="ir.actions.act_window">
            <field name="name">Forge Stages</field>
            <field name="res_model">forge.stage</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>
