<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Weapon Kanban View -->
    <record id="forge_weapon_view_kanban" model="ir.ui.view">
        <field name="name">forge.weapon.kanban</field>
        <field name="model">forge.weapon</field>
        <field name="arch" type="xml">
            <kanban default_group_by="progress_stage" class="o_kanban_small_column" on_create="quick_create">
                <!-- Campos necesarios -->
                <field name="name"/>
                <field name="client_id"/>
                <field name="client_email"/>
                <field name="weapon_type"/>
                <field name="responsible_id"/>
                <field name="progress"/>
                <field name="progress_stage"/>
                <field name="is_requested"/>
                <field name="is_in_progress"/>
                <field name="is_ready"/>
                <field name="is_delivered"/>
                <field name="end_date"/>

                <!-- Botón para crear nuevo -->
                <control>
                    <create string="Nueva Arma"/>
                </control>

                <templates>
                    <!-- Plantilla para cada tarjeta -->
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click o_kanban_record_has_image_fill">
                            <!-- Cabecera con nombre y tipo -->
                            <div class="o_kanban_record_top mb-2">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div class="o_kanban_record_subtitle text-muted">
                                        <field name="weapon_type"/>
                                    </div>
                                </div>
                            </div>

                            <!-- Usuario responsable con avatar -->
                            <div class="o_kanban_record_body">
                                <div class="d-flex align-items-center mb-2">
                                    <img t-att-src="kanban_image('res.users', 'avatar_128', record.responsible_id.raw_value)"
                                         class="o_kanban_avatar o_image_24_cover me-2" alt="Responsable"/>
                                    <span><field name="responsible_id"/></span>
                                </div>

                                <!-- Barra de progreso -->
                                <div>
                                    <field name="progress" widget="progressbar" options="{'current_value': 'progress', 'max_value': 100, 'editable': true}"/>
                                </div>

                                <!-- Fecha de finalización -->
                                <div class="mt-2">
                                    <i class="fa fa-calendar me-2"></i>
                                    <field name="end_date"/>
                                </div>

                                <!-- Email del cliente -->
                                <div class="mt-2" t-if="record.client_email.raw_value">
                                    <i class="fa fa-envelope-o me-2"></i>
                                    <field name="client_email"/>
                                </div>
                            </div>

                            <!-- Estado basado en progreso -->
                            <div class="o_kanban_record_bottom mt-2">
                                <div class="oe_kanban_bottom_left">
                                    <span t-if="record.is_requested.raw_value" class="badge bg-info">Solicitada</span>
                                    <span t-if="record.is_in_progress.raw_value" class="badge bg-warning">En Progreso</span>
                                    <span t-if="record.is_ready.raw_value" class="badge bg-success">Lista</span>
                                    <span t-if="record.is_delivered.raw_value" class="badge bg-danger">Entregada</span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Weapon Form View -->
    <record id="forge_weapon_view_form" model="ir.ui.view">
        <field name="name">forge.weapon.form</field>
        <field name="model">forge.weapon</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- Selector de etapas basado en el campo computado -->
                    <field name="progress_stage" widget="statusbar" options="{'clickable': false}"/>
                    
                    <!-- Grupo de botones para cambio de etapa -->
                    <button name="action_mark_requested" string="Solicitada" type="object" 
                            class="oe_highlight" invisible="is_requested or is_delivered"/>
                    <button name="action_mark_in_progress" string="Iniciar Trabajo" type="object" 
                            class="oe_highlight" invisible="is_in_progress or is_delivered"/>
                    <button name="action_mark_ready" string="Lista para Entrega" type="object" 
                            class="oe_highlight" invisible="is_ready or is_delivered"/>
                    <button name="action_mark_delivered" string="Confirmar Entrega" type="object" 
                            class="oe_highlight" invisible="is_delivered"/>
                    
                    <!-- Grupo de botones para envío de correos, muestran una sola vez -->
                    <button name="action_send_requested_email" string="Notificar Solicitud" type="object" 
                            class="btn-secondary" invisible="not is_requested"/>
                    <button name="action_send_in_progress_email" string="Notificar Inicio" type="object" 
                            class="btn-secondary" invisible="not is_in_progress"/>
                    <button name="action_send_ready_email" string="Notificar Listo" type="object" 
                            class="btn-secondary" invisible="not is_ready"/>
                    <button name="action_send_delivered_email" string="Notificar Entrega" type="object" 
                            class="btn-secondary" invisible="not is_delivered"/>
                </header>
                
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nombre del arma"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="client_id" required="1"/>
                            <field name="weapon_type" required="1"/>
                            <field name="responsible_id"/>
                            <field name="progress" widget="progressbar"/>
                            <!-- Campos computados ocultos para condiciones de visibilidad -->
                            <field name="is_requested" invisible="1"/>
                            <field name="is_in_progress" invisible="1"/>
                            <field name="is_ready" invisible="1"/>
                            <field name="is_delivered" invisible="1"/>
                            <field name="progress_stage" invisible="1"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="delivery_date" readonly="not is_delivered"/>
                            <field name="client_email"/>
                            <field name="client_phone"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Descripción">
                            <field name="description" placeholder="Descripción detallada del arma..."/>
                        </page>
                        <page string="Materiales">
                            <field name="materials" placeholder="Materiales necesarios..."/>
                        </page>
                        <page string="Notas">
                            <field name="notes" placeholder="Notas adicionales..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Weapon Tree View -->
    <record id="forge_weapon_view_tree" model="ir.ui.view">
        <field name="name">forge.weapon.tree</field>
        <field name="model">forge.weapon</field>
        <field name="arch" type="xml">
            <tree string="Weapons" decoration-info="is_requested" decoration-warning="is_in_progress" decoration-success="is_ready" decoration-danger="is_delivered">
                <field name="name"/>
                <field name="weapon_type"/>
                <!-- Reemplazamos stage_id con los campos computados -->
                <field name="is_requested" invisible="1"/>
                <field name="is_in_progress" invisible="1"/>
                <field name="is_ready" invisible="1"/>
                <field name="is_delivered" invisible="1"/>
                <!-- Campo estado basado en progreso -->
                <field name="progress" widget="progressbar"/>
                <field name="client_id"/>
                <field name="responsible_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <!-- Añadimos un campo de estado calculado para mostrar en la vista -->
                <field name="progress" string="Estado" widget="badge"
                       decoration-info="progress &lt; 10"
                       decoration-warning="progress &gt;= 10 and progress &lt; 90"
                       decoration-success="progress &gt;= 90 and progress &lt; 100"
                       decoration-danger="progress &gt;= 100"/>
            </tree>
        </field>
    </record>

    <!-- Weapon Search View -->
    <record id="forge_weapon_view_search" model="ir.ui.view">
        <field name="name">forge.weapon.search</field>
        <field name="model">forge.weapon</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="weapon_type"/>
                <field name="responsible_id"/>
                <field name="client_id"/>

                <!-- Filtros por etapa basados en el progreso -->
                <filter string="Solicitada" name="filter_requested" domain="[('progress', '&lt;', 10)]"/>
                <filter string="En Progreso" name="filter_in_progress" domain="[('progress', '&gt;=', 10), ('progress', '&lt;', 90)]"/>
                <filter string="Lista para Entrega" name="filter_ready" domain="[('progress', '&gt;=', 90), ('progress', '&lt;', 100)]"/>
                <filter string="Entregada" name="filter_delivered" domain="[('progress', '&gt;=', 100)]"/>

                <filter string="My Weapons" name="my_weapons" domain="[('responsible_id', '=', uid)]"/>

                <group expand="0" string="Group By">
                    <!-- Agrupar por progreso (como etapas) -->
                    <filter string="Etapa" name="group_by_progress" context="{'group_by': 'progress'}"/>
                    <filter string="Weapon Type" name="group_by_type" context="{'group_by': 'weapon_type'}"/>
                    <filter string="Client" name="group_by_client" context="{'group_by': 'client_id'}"/>
                    <filter string="Responsible" name="group_by_responsible" context="{'group_by': 'responsible_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Weapon Action Window -->
    <record id="action_forge_weapon" model="ir.actions.act_window">
        <field name="name">Weapons</field>
        <field name="res_model">forge.weapon</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_my_weapons': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first weapon
            </p>
            <p>
                Track your weapon creation process from design to delivery.
            </p>
        </field>
    </record>

    <!-- Historical Weapons Action -->
    <record id="action_forge_weapon_history" model="ir.actions.act_window">
        <field name="name">Weapons History</field>
        <field name="res_model">forge.weapon</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('progress', '>=', 100)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_neutral_face">
                No delivered weapons yet
            </p>
            <p>
                Your delivered weapons will appear here.
            </p>
        </field>
    </record>

    <!-- Botón de Nueva Arma en la acción principal -->
    <record id="forge_weapon_action" model="ir.actions.act_window">
        <field name="name">Armas</field>
        <field name="res_model">forge.weapon</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'create': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ¡Crea tu primera arma!
            </p>
            <p>
                <a type="action" name="%(forge_weapon_view_form)d" class="btn btn-primary">
                    <i class="fa fa-plus"></i> Nueva Arma
                </a>
            </p>
            <p>
                Crea un registro de arma para comenzar a gestionar su proceso de forjado.
            </p>
        </field>
    </record>

    <!-- Vista principal y menú de kanban que incluye el botón de crear -->
    <record id="forge_weapon_kanban_action" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="forge_weapon_view_kanban"/>
        <field name="act_window_id" ref="forge_weapon_action"/>
    </record>
</odoo>
