<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Weapon Kanban View -->
    <record id="forge_weapon_view_kanban" model="ir.ui.view">
        <field name="name">forge.weapon.kanban</field>
        <field name="model">forge.weapon</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_small_column" on_create="quick_create">
                <field name="name"/>
                <field name="weapon_type"/>
                <field name="responsible_id"/>
                <field name="client_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="progress"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div>
                                    <strong><field name="name"/></strong>
                                </div>
                                <div>
                                    <span class="badge rounded-pill text-bg-secondary">
                                        <field name="weapon_type"/>
                                    </span>
                                </div>
                                <div class="mt-2">
                                    <field name="responsible_id" widget="many2one_avatar_user"/>
                                </div>
                                <div class="mt-1">
                                    <i class="fa fa-user" role="img" aria-label="Client"/><span class="ps-1"><field name="client_id"/></span>
                                </div>
                                <div class="mt-2">
                                    <div class="progress" style="height: 6px;">
                                        <div class="progress-bar" role="progressbar" t-attf-style="width: {{record.progress.raw_value}}%" t-attf-aria-valuenow="{{record.progress.raw_value}}" aria-valuemin="0" aria-valuemax="100"/>
                                    </div>
                                    <small class="text-muted"><t t-esc="Math.round(record.progress.raw_value)"/>% complete</small>
                                </div>
                                <div class="text-muted mt-2">
                                    <i class="fa fa-calendar" role="img" aria-label="Ending date"/><span class="ps-1"><field name="end_date"/></span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Weapon Form View -->
    <record id="forge_weapon_view_form" model="ir.ui.view">
        <field name="name">forge.weapon.form</field>
        <field name="model">forge.weapon</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="stage_id" widget="statusbar" options="{'clickable': '1'}"/>
                    <!-- New syntax: use invisible="1" combined with condition in Python -->
                    <button name="action_mark_delivered" string="Mark as Delivered" type="object"
                            class="oe_highlight" invisible="stage_id.name == 'Entregada'"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_client" type="object" class="oe_stat_button" icon="fa-user">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">View</span>
                                <span class="o_stat_text">Client</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Weapon Name"/></h1>
                    </div>
                    <group>
                        <group name="basic_info">
                            <field name="weapon_type"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="delivery_date" readonly="stage_id.name != 'Entregada'"/>
                        </group>
                        <group name="people">
                            <field name="responsible_id"/>
                            <field name="client_id" context="{'show_address': 1}" options="{'always_reload': True}"/>
                            <field name="client_email" readonly="1"/>
                            <field name="client_phone" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="progress" widget="progressbar"/>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Detailed description of the weapon..."/>
                        </page>
                        <page string="Materials">
                            <field name="materials_notes" placeholder="List the materials used..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Weapon Tree View -->
    <record id="forge_weapon_view_tree" model="ir.ui.view">
        <field name="name">forge.weapon.tree</field>
        <field name="model">forge.weapon</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="weapon_type"/>
                <field name="stage_id"/>
                <field name="client_id"/>
                <field name="responsible_id"/>
                <field name="progress" widget="progressbar"/>
                <field name="start_date"/>
                <field name="end_date"/>
            </tree>
        </field>
    </record>

    <!-- Weapon Search View -->
    <record id="forge_weapon_view_search" model="ir.ui.view">
        <field name="name">forge.weapon.search</field>
        <field name="model">forge.weapon</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="weapon_type"/>
                <field name="responsible_id"/>
                <field name="client_id"/>
                <filter string="My Weapons" name="my_weapons" domain="[('responsible_id', '=', uid)]"/>
                <group expand="0" string="Group By">
                    <filter string="Stage" name="group_by_stage" context="{'group_by': 'stage_id'}"/>
                    <filter string="Weapon Type" name="group_by_type" context="{'group_by': 'weapon_type'}"/>
                    <filter string="Client" name="group_by_client" context="{'group_by': 'client_id'}"/>
                    <filter string="Responsible" name="group_by_responsible" context="{'group_by': 'responsible_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Weapon Action Window -->
    <record id="action_forge_weapon" model="ir.actions.act_window">
        <field name="name">Weapons</field>
        <field name="res_model">forge.weapon</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_my_weapons': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first weapon
            </p>
            <p>
                Track your weapon creation process from design to delivery.
            </p>
        </field>
    </record>

    <!-- Historical Weapons Action -->
    <record id="action_forge_weapon_history" model="ir.actions.act_window">
        <field name="name">Weapons History</field>
        <field name="res_model">forge.weapon</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('stage_id.name', '=', 'Entregada')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_neutral_face">
                No delivered weapons yet
            </p>
            <p>
                Your delivered weapons will appear here.
            </p>
        </field>
    </record>
</odoo>
