<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Weapon Kanban View -->
    <record id="forge_weapon_view_kanban" model="ir.ui.view">
        <field name="name">forge.weapon.kanban</field>
        <field name="model">forge.weapon</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_small_column" on_create="quick_create">
                <field name="stage_id"/>
                <field name="name"/>
                <field name="client_id"/>
                <field name="client_email"/>
                <field name="weapon_type"/>
                <field name="responsible_id"/>
                <field name="progress"/>
                <field name="state"/>
                <field name="end_date"/>
                
                <!-- Control de creación en cada columna -->
                <control>
                    <create string="Nueva Arma" context="{'default_stage_id': active_id}"/>
                </control>
                
                <templates>
                    <!-- Plantilla para cada tarjeta -->
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click o_kanban_record_has_image_fill">
                            <!-- Cabecera con nombre y tipo -->
                            <div class="o_kanban_record_top mb-2">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                    <div class="o_kanban_record_subtitle text-muted">
                                        <field name="weapon_type"/>
                                    </div>
                                </div>
                            </div>
                            
                            <!-- Usuario responsable con avatar -->
                            <div class="o_kanban_record_body">
                                <div class="d-flex align-items-center mb-2">
                                    <img t-att-src="kanban_image('res.users', 'avatar_128', record.responsible_id.raw_value)" 
                                         class="o_kanban_avatar o_image_24_cover me-2" alt="Responsable"/>
                                    <span><field name="responsible_id"/></span>
                                </div>
                                
                                <!-- Barra de progreso -->
                                <div>
                                    <field name="progress" widget="progressbar" options="{'current_value': 'progress', 'max_value': 100, 'editable': false}"/>
                                </div>
                                
                                <!-- Fecha de finalización -->
                                <div class="mt-2">
                                    <i class="fa fa-calendar me-2"></i>
                                    <field name="end_date"/>
                                </div>
                                
                                <!-- Email del cliente (nuevo) -->
                                <div class="mt-2" t-if="record.client_email.raw_value">
                                    <i class="fa fa-envelope-o me-2"></i>
                                    <field name="client_email"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Weapon Form View -->
    <record id="forge_weapon_view_form" model="ir.ui.view">
        <field name="name">forge.weapon.form</field>
        <field name="model">forge.weapon</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <!-- Estado y botones de cambio de estado -->
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                    
                    <!-- Botones para enviar correos (con nueva sintaxis) -->
                    <button name="action_send_requested_email" string="Enviar correo: Arma solicitada" type="object" 
                        class="oe_highlight" invisible="state != 'requested'"/>
                    <button name="action_send_in_progress_email" string="Enviar correo: En progreso" type="object" 
                        class="oe_highlight" invisible="state != 'in_progress'"/>
                    <button name="action_send_ready_email" string="Enviar correo: Arma lista" type="object" 
                        class="oe_highlight" invisible="state != 'ready'"/>
                    <button name="action_send_delivered_email" string="Enviar correo: Entregada" type="object" 
                        class="oe_highlight" invisible="state != 'delivered'"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Nombre del arma"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="client_id" required="1"/>
                            <field name="weapon_type" required="1"/>
                            <field name="responsible_id"/>
                            <field name="progress" widget="progressbar"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="delivery_date" readonly="state != 'delivered'"/>
                            <field name="stage_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Descripción">
                            <field name="description" placeholder="Descripción detallada del arma..."/>
                        </page>
                        <page string="Materiales">
                            <field name="materials" placeholder="Materiales necesarios..."/>
                        </page>
                        <page string="Notas">
                            <field name="notes" placeholder="Notas adicionales..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Weapon Tree View -->
    <record id="forge_weapon_view_tree" model="ir.ui.view">
        <field name="name">forge.weapon.tree</field>
        <field name="model">forge.weapon</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="weapon_type"/>
                <field name="stage_id"/>
                <field name="client_id"/>
                <field name="responsible_id"/>
                <field name="progress" widget="progressbar"/>
                <field name="start_date"/>
                <field name="end_date"/>
            </tree>
        </field>
    </record>

    <!-- Weapon Search View -->
    <record id="forge_weapon_view_search" model="ir.ui.view">
        <field name="name">forge.weapon.search</field>
        <field name="model">forge.weapon</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="weapon_type"/>
                <field name="responsible_id"/>
                <field name="client_id"/>
                <filter string="My Weapons" name="my_weapons" domain="[('responsible_id', '=', uid)]"/>
                <group expand="0" string="Group By">
                    <filter string="Stage" name="group_by_stage" context="{'group_by': 'stage_id'}"/>
                    <filter string="Weapon Type" name="group_by_type" context="{'group_by': 'weapon_type'}"/>
                    <filter string="Client" name="group_by_client" context="{'group_by': 'client_id'}"/>
                    <filter string="Responsible" name="group_by_responsible" context="{'group_by': 'responsible_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Weapon Action Window -->
    <record id="action_forge_weapon" model="ir.actions.act_window">
        <field name="name">Weapons</field>
        <field name="res_model">forge.weapon</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_my_weapons': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first weapon
            </p>
            <p>
                Track your weapon creation process from design to delivery.
            </p>
        </field>
    </record>

    <!-- Historical Weapons Action -->
    <record id="action_forge_weapon_history" model="ir.actions.act_window">
        <field name="name">Weapons History</field>
        <field name="res_model">forge.weapon</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('stage_id.name', '=', 'Entregada')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_neutral_face">
                No delivered weapons yet
            </p>
            <p>
                Your delivered weapons will appear here.
            </p>
        </field>
    </record>

    <!-- Botón de Nueva Arma en la acción principal -->
    <record id="forge_weapon_action" model="ir.actions.act_window">
        <field name="name">Armas</field>
        <field name="res_model">forge.weapon</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'create': True}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ¡Crea tu primera arma!
            </p>
            <p>
                <a type="action" name="%(forge_weapon_view_form)d" class="btn btn-primary">
                    <i class="fa fa-plus"></i> Nueva Arma
                </a>
            </p>
            <p>
                Crea un registro de arma para comenzar a gestionar su proceso de forjado.
            </p>
        </field>
    </record>

    <!-- Vista principal y menú de kanban que incluye el botón de crear -->
    <record id="forge_weapon_kanban_action" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="forge_weapon_view_kanban"/>
        <field name="act_window_id" ref="forge_weapon_action"/>
    </record>
</odoo>
