<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Etapas predefinidas -->
    <record id="stage_requested" model="forge.stage">
        <field name="name">Pedida</field>
        <field name="sequence">10</field>
        <field name="stage_state">requested</field>
        <field name="progress_value">0</field>
    </record>

    <record id="stage_in_progress" model="forge.stage">
        <field name="name">Realizada</field>
        <field name="sequence">20</field>
        <field name="stage_state">in_progress</field>
        <field name="progress_value">70</field>
    </record>

    <record id="stage_ready" model="forge.stage">
        <field name="name">Lista</field>
        <field name="sequence">30</field>
        <field name="stage_state">ready</field>
        <field name="progress_value">95</field>
    </record>

    <record id="stage_delivered" model="forge.stage">
        <field name="name">Entregada</field>
        <field name="sequence">40</field>
        <field name="stage_state">delivered</field>
        <field name="progress_value">100</field>
        <field name="fold">true</field>
    </record>

    <record id="stage_cancelled" model="forge.stage">
        <field name="name">Cancelada</field>
        <field name="sequence">50</field>
        <field name="stage_state">cancelled</field>
        <field name="fold">true</field>
    </record>
</odoo>
